{
    "settings": {
        "go.useLanguageServer": true,
        "go.formatTool": "gofmt",
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        "go.vetOnSave": "package",
        "go.buildOnSave": "package",
        "go.testOnSave": false,
        "editor.formatOnSave": true,
        "go.testFlags": [],
        "go.testTimeout": "30s"
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Launch Package",
                "type": "go",
                "request": "launch",
                "mode": "auto",
                "program": "${workspaceFolder}",
                "preLaunchTask": "go: build",
                "env": {},
                "args": []
            },
            {
                "name": "Debug Current File",
                "type": "go",
                "request": "launch",
                "mode": "auto",
                "program": "${file}",
                "preLaunchTask": "go: build"
            },
            {
                "name": "Debug Tests in Package",
                "type": "go",
                "request": "launch",
                "mode": "test",
                "program": "${workspaceFolder}"
            },
            {
                "name": "Attach to Delve (local)",
                "type": "go",
                "request": "attach",
                "mode": "local",
                "port": 2345,
                "host": "127.0.0.1"
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "go: build",
                "type": "shell",
                "command": "go build ./...",
                "problemMatcher": [
                    "$go"
                ],
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "go: test",
                "type": "shell",
                "command": "go test ./... -v",
                "problemMatcher": [
                    "$go"
                ],
                "group": "test"
            },
            {
                "label": "go: test current package",
                "type": "shell",
                "command": "go test ./${relativeFileDirname} -v",
                "problemMatcher": [
                    "$go"
                ]
            }
        ]
    }
}